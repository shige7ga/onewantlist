<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center px-4">
  <div class="card w-full max-w-md bg-white shadow-xl">
    <div class="card-body">
      <h2 class="card-title justify-center text-2xl font-bold">
        <%= t(".title") %>
      </h2>
      <%= render "shared/flash", flash: flash %>

      <%= form_with(model: @want, html: { class: "space-y-4", novalidate: true }) do |f| %>
        <% invalids = %i[ content status due_date ].index_with do |attribute|
          f.object.errors[attribute].any?
        end %>

        <%# やりたいこと内容 %>
        <div>
          <%= f.text_area :content,
                      autofocus: true,
                      rows: 8,
                      "aria-invalid": invalids[:content],
                      "aria-describedby": (f.field_id(:content, :errors) if invalids[:content]),
                      class: "textarea textarea-bordered w-full bg-color #{invalids[:content] ? 'border-red-500' : 'border-app-accent'} focus:outline-none" %>
          <%= render "shared/field_errors", form: f, attribute: :content %>
        </div>

        <%# ステータス %>
        <div>
          <%= f.label :status,
                      Want.human_attribute_name(:status),
                      class: "mb-1 block text-sm font-semibold" %>
          <%= f.select :status,
                        Want.statuses.keys.map { |status|
                          [ t("activerecord.enums.want.status.#{status}"), status ]
                        },
                        {},
                        "aria-invalid": invalids[:status],
                        "aria-describedby": (f.field_id(:status, :errors) if invalids[:status]),
                        class: "select select-bordered w-full border-app-accent bg-color focus:outline-none #{invalids[:status] ? 'border-red-500' : 'border-app-accent'} " %>
          <%= render "shared/field_errors", form: f, attribute: :status %>
        </div>

        <%# 期限日 %>
        <div>
          <%= f.label :due_date,
                      Want.human_attribute_name(:due_date),
                      class: "mb-1 block text-sm font-semibold" %>

          <%= f.date_field :due_date,
                      "aria-invalid": invalids[:due_date],
                      "aria-describedby": (f.field_id(:due_date, :errors) if invalids[:due_date]),
                      class: "input input-bordered w-full bg-color #{invalids[:due_date] ? 'border-red-500' : 'border-app-accent'} focus:outline-none",
                      min: Date.current  %>
          <%= render "shared/field_errors", form: f, attribute: :due_date %>
        </div>

        <%# 更新ボタン %>
        <div class="pt-2">
          <%= f.submit class: "btn w-full border-none bg-app-accent text-color hover:bg-[#E3C88F]" %>
        </div>

      <% end %>
    </div>
  </div>
</div>
