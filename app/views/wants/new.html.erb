<% page_title = t(".title") %>

<%# 今日のやりたいこと登録状況 %>
<% today_registered = @status.last_want_registration_date == Date.current %>

<%# 通常のガチャ抽選が可能か %>
<% can_draw_gacha = !today_registered && @status.random_gacha_available? %>

<%# ガチャの遷移先・リクエスト方法 %>
<% gacha_path = can_draw_gacha ? draw_random_want_path : random_want_path %>

<% gacha_data = can_draw_gacha ? { turbo_method: :post } : {} %>

<%= render layout: "shared/layouts/centered_card",
           locals: {
             back_path: owner_home_path,
             back_label: "マイページに戻る",
             max_width: "max-w-md",
             header_action: {
              label: "やりたいことガチャ画面へ →",
              path: gacha_path,
              variant: :gacha,
              data: gacha_data
             }
           } do %>

  <div class="card-body">
    <h2 class="page-title">
      <%= page_title %>
    </h2>

    <%= render "shared/flash", flash: flash %>

    <%= form_with(model: @want, html: { class: "space-y-4" }) do |f| %>
      <%= hidden_field_tag :registration_source, "direct" %>
      <div>
        <% invalid = f.object.errors[:content].any? %>
        <%= f.text_area :content,
                    autofocus: true,
                    rows: 8,
                    "aria-invalid": invalid,
                    "aria-describedby": (f.field_id(:content, :errors) if invalid),
                    class: "textarea form-field rounded-2xl"
                    %>

        <%= render "shared/field_errors", form: f, attribute: :content %>
      </div>
      <%= f.submit class: "form-btn" %>
    <% end %>
  </div>

<% end %>
