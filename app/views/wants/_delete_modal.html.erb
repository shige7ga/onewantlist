<button
  type="button"
  onclick="delete_modal.showModal()"
  class="simple-btn simple-btn-danger"
>
  <%= t(".btn") %>
</button>

<dialog id="delete_modal" class="modal">
  <div class="modal-box">
    <h3 class="text-lg font-bold">
      <%= t(".confirm") %>
    </h3>

    <p class="py-4 text-gray-600">
      <%= t(".alert") %>
    </p>

    <div class="modal-action">
      <form method="dialog">
        <button class="simple-btn">
          <%= t(".cancel") %>
        </button>
      </form>

      <%= button_to t(".completed_delete_btn"),
                    want_path(@want),
                    method: :delete,
                    class: "simple-btn simple-btn-danger" %>
    </div>
  </div>
</dialog>
