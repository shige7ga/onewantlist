<% page_title = t(".title") %>
<% edit_btn = t(".edit_btn") %>

<%= render layout: "shared/layouts/centered_card",
           locals: {
             back_path: owner_home_path,
             back_label: "マイページに戻る",
             max_width: "max-w-lg"
           } do %>

  <div class="card-body gap-5 p-6">
    <h2 class="page-title">
      <%= page_title %>
    </h2>
    <%= render "shared/flash", flash: flash %>

    <%# やりたいこと内容 %>
    <div>
      <div class="rounded-lg bg-color p-4">
        <p class="whitespace-pre-wrap break-words text-lg font-semibold leading-relaxed"><%= @want.content %></p>
      </div>
    </div>

    <%# ステータス・期限 %>
    <div class="flex flex-wrap items-center gap-4">
      <div>
        <p class="mb-1 text-sm font-semibold text-color/70">
          <%= Want.human_attribute_name(:status) %>
        </p>

        <span class="badge border-none bg-app-accent text-color rounded-full">
          <%= t("activerecord.enums.want.status.#{@want.status}") %>
        </span>
      </div>

      <div>
        <p class="mb-1 text-sm font-semibold text-color/70">
          <%= Want.human_attribute_name(:due_date) %>
        </p>

        <p>
          <%= @want.due_date.present? ? @want.due_date.strftime("%Y/%m/%d") : t("wants.non_due_date") %>
        </p>
      </div>

      <div>
        <p class="mb-1 text-sm font-semibold text-color/70">
          <%= Want.human_attribute_name(:created_at) %>
        </p>

        <p>
          <%= @want.created_at.strftime("%Y/%m/%d %H:%M") %>
        </p>
      </div>
    </div>

    <%# 編集ボタン %>
    <div class="card-actions mt-2 justify-end">
      <%= link_to edit_btn,
                  edit_want_path(@want),
                  class: "simple-btn" %>

      <%# 削除ボタン %>
      <%= render "delete_modal", want: @want %>
    </div>

  </div>
<% end %>
