<div class="space-y-4">
  <% wants.each do |want| %>
    <div class="app-card transition duration-200 hover:shadow-lg">

      <div class="card-body gap-3 p-4">

        <%# やりたいこと %>
        <div class="flex items-start justify-between gap-4">
          <p class="min-w-0 flex-1 whitespace-pre-wrap break-words text-lg font-semibold"><%= want.content %></p>
        </div>

        <%# ステータス・期日・詳細ボタン %>
        <div class="flex flex-wrap items-center gap-2 text-sm">
          <%= render "wants/status_select", want: want %>

          <span>
            <%= Want.human_attribute_name(:due_date) %>：
            <%= want.due_date.present? ? want.due_date.strftime("%Y/%m/%d") : t("wants.non_due_date") %>
          </span>

          <%= link_to "詳細", want_path(want), class: "simple-btn ml-auto" %>
        </div>

        <%# 作成日 %>
        <div class="text-xs text-gray-400">
          <%= Want.human_attribute_name(:created_at) %>：<%= want.created_at.strftime("%Y/%m/%d") %>
        </div>
      </div>
    </div>
  <% end %>
</div>
