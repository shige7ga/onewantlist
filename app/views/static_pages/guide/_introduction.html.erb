<%# ============================================
    Introduction：使い方ガイド
============================================ %>
<section
  id="guide-introduction"
  aria-labelledby="guide-introduction-title"
  class="bg-[#F6F5EE] px-5 py-14 sm:py-20"
>
  <div class="mx-auto max-w-3xl text-center">

    <%# 小見出し %>
    <span class="inline-block rounded-full bg-[#A8BFA0]/30 px-4 py-1 text-xs font-bold tracking-widest text-[#4F5A4C]">
      GUIDE
    </span>

    <%# ページタイトル %>
    <h1
      id="guide-introduction-title"
      class="mt-5 text-3xl font-bold sm:text-4xl"
    >
      使い方ガイド
    </h1>

    <p class="mt-3 text-sm font-medium text-[#7D9876]">
      わんわんとリストの楽しみ方
    </p>

    <%# 区切り線 %>
    <div
      class="mx-auto my-10 h-px w-16 bg-[#A8BFA0]"
      aria-hidden="true"
    ></div>

    <%# メインメッセージ %>
    <h2 class="text-xl font-bold leading-relaxed sm:text-2xl">
      「やってみたい」を、少しずつ集めよう。
    </h2>

    <%# ページ紹介 %>
    <div class="mx-auto mt-6 max-w-[30em] space-y-4 text-sm leading-8 sm:text-base">

      <p>
        やりたいことを登録したり、<br>
        ガチャで新しい興味を見つけたり。
      </p>

      <p>
        日々の小さな積み重ねを、<br>
        経験値やレベルアップで楽しめます。
      </p>

      <p>
        ここでは、基本的な使い方とご利用のルールをご紹介します。
      </p>

    </div>

  </div>
</section>
