<%# ログイン済みユーザーには表示しない %>
<% unless user_signed_in? %>

  <section
    aria-label="わんわんとリストを体験"
    class="bg-[#F6F5EE] px-5 py-12"
  >
    <div class="mx-auto max-w-xl text-center">

      <h2 class="text-xl font-bold text-[#4F5A4C]">
        まずは、ひとつから。
      </h2>

      <p class="mt-4 text-sm leading-8 text-[#4F5A4C]">
        気になったら、まずは気軽に試してみませんか？
      </p>

      <%= link_to "体験してみる →",
                  guest_user_path,
                  class: "mt-6 inline-block rounded-full bg-[#A8BFA0] px-8 py-3 text-sm font-bold text-[#354133] shadow-sm transition-all duration-200 hover:bg-[#96AE8E] hover:shadow-md transition-transform duration-200 hover:scale-105" %>

      <p class="mt-3 text-xs text-[#7D9876]">
        登録不要でお試しできます
      </p>

    </div>
  </section>

<% end %>
