<%# ログイン済みユーザーには表示しない %>
<% unless user_signed_in? %>

  <section
    aria-label="わんわんとリストを体験"
    class="px-5 py-12"
  >
    <div class="mx-auto max-w-xl text-center">

      <h2 class="text-xl font-bold">
        まずは、ひとつから。
      </h2>

      <p class="mt-4 text-sm leading-8">
        気になったら、まずは気軽に試してみませんか？
      </p>

      <%= link_to "体験してみる →",
                  guest_user_path,
                  class: "guest-cta-button max-w-sm mt-6" %>

      <p class="mt-3 text-xs text-sub-text">
        登録不要でお試しできます
      </p>

    </div>
  </section>

<% end %>
