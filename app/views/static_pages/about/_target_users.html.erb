<%# ============================================
    Target Users：こんなあなたに届けたい
============================================ %>
<section
  id="target-users"
  aria-labelledby="target-users-title"
  class="bg-[#E9EFE5] px-5 py-14 sm:py-20"
>
  <div class="mx-auto max-w-3xl">

    <%# セクション見出し %>
    <div class="text-center">

      <span class="inline-block rounded-full bg-[#A8BFA0]/40 px-4 py-1 text-xs font-bold tracking-widest text-[#4F5A4C]">
        FOR YOU
      </span>

      <h2
        id="target-users-title"
        class="mt-4 text-2xl font-bold leading-relaxed sm:text-3xl"
      >
        こんなあなたに、使ってほしい。
      </h2>

      <div
        class="mx-auto mt-8 h-px w-16 bg-[#A8BFA0]"
        aria-hidden="true"
      ></div>

      <p class="mx-auto mt-8 max-w-[30em] text-left text-sm leading-8 sm:text-base sm:leading-9 md:text-center">
        わんわんとリストは、<br class="hidden sm:block">
        すべての人にぴったりのアプリではありません。
      </p>

    </div>

    <%# こんな方におすすめ %>
    <div class="mx-auto mt-10 max-w-2xl rounded-3xl bg-white px-5 py-8 shadow-sm sm:px-10 sm:py-10">

      <h3 class="text-center text-lg font-bold sm:text-xl">
        こんな方におすすめ
      </h3>

      <div
        class="mx-auto mt-5 h-px w-12 bg-[#A8BFA0]"
        aria-hidden="true"
      ></div>

      <div class="mt-8 space-y-8">

        <%# 01 %>
        <div class="text-left md:text-center">

          <p class="text-sm font-bold leading-7 sm:text-base">
            毎日に、ちょっとした変化がほしい方
          </p>

          <p class="mt-2 text-sm leading-8">
            何か新しいことをしてみたいけれど、<br class="hidden sm:block">
            何から始めたらいいかわからない。
          </p>

        </div>

        <%# 02 %>
        <div class="text-left md:text-center">

          <p class="text-sm font-bold leading-7 sm:text-base">
            自分の「やってみたい」を見つけたい方
          </p>

          <p class="mt-2 text-sm leading-8">
            自分と向き合う時間をつくりたい。<br class="hidden sm:block">
            でも、何をしたいのか、まだはっきりしていない。
          </p>

        </div>

        <%# 03 %>
        <div class="text-left md:text-center">

          <p class="text-sm font-bold leading-7 sm:text-base">
            がんばりすぎずに、続けていきたい方
          </p>

          <p class="mt-2 text-sm leading-8">
            やりたいことリストを作ってみたけれど、<br class="hidden sm:block">
            いつの間にか続かなくなってしまった経験がある。
          </p>

        </div>

      </div>

    </div>

    <%# こんな方には少し物足りないかも %>
    <div class="mx-auto mt-6 max-w-2xl rounded-3xl bg-[#F6F5EE] px-5 py-8 shadow-sm sm:px-10 sm:py-10">

      <h3 class="text-center text-lg font-bold leading-relaxed sm:text-xl">
        こんな方には、<br class="sm:hidden">
        少し物足りないかも
      </h3>

      <div
        class="mx-auto mt-5 h-px w-12 bg-[#A8BFA0]"
        aria-hidden="true"
      ></div>

      <div class="mt-8 space-y-8">

        <%# 01 %>
        <div class="text-left md:text-center">

          <p class="text-sm font-bold leading-7 sm:text-base">
            やりたいことを、どんどん登録したい方
          </p>

          <p class="mt-2 text-sm leading-8">
            思いついたことを、一度にたくさん書き留めたい。
          </p>

        </div>

        <%# 02 %>
        <div class="text-left md:text-center">

          <p class="text-sm font-bold leading-7 sm:text-base">
            すでに、自分に合う方法がある方
          </p>

          <p class="mt-2 text-sm leading-8">
            ほかのアプリやノートで、無理なく継続できている。
          </p>

        </div>

        <%# 03 %>
        <div class="text-left md:text-center">

          <p class="text-sm font-bold leading-7 sm:text-base">
            目標を細かく管理したい方
          </p>

          <p class="mt-2 text-sm leading-8">
            タスクやスケジュールを管理して、効率よく目標達成を目指したい。
          </p>

        </div>

      </div>

    </div>

    <%# 締めのメッセージ %>
    <div class="mt-12 text-center">

      <div
        class="mx-auto h-px w-12 bg-[#A8BFA0]"
        aria-hidden="true"
      ></div>

      <p class="mt-8 text-lg font-bold leading-relaxed sm:text-xl">
        自分に合ったペースが、いちばん。
      </p>

      <p class="mt-4 text-sm leading-8 sm:text-base">
        今のあなたに、ちょうどよさそう。<br>
        そう感じたら、気軽に試してみてください。
      </p>

    </div>

  </div>
</section>
