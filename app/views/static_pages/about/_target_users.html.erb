<%# ============================================
    FOR YOU：こんなあなたに、使ってほしい。
============================================ %>
<section
  id="target-users"
  aria-labelledby="target-users-title"
  class="bg-[#E9EFE5] px-5 py-14 text-[#4F5A4C] sm:py-20"
>
  <div class="mx-auto max-w-3xl">

    <%# セクション見出し %>
    <div class="text-center">

      <span class="inline-block rounded-full bg-[#A8BFA0]/40 px-4 py-1 text-xs font-bold tracking-widest">
        FOR YOU
      </span>

      <h2
        id="target-users-title"
        class="mt-4 text-2xl font-bold leading-relaxed sm:text-3xl"
      >
        こんなあなたに、使ってほしい。
      </h2>

      <div
        class="mx-auto mt-8 h-px w-16 bg-[#A8BFA0]"
        aria-hidden="true"
      ></div>

      <p class="mx-auto mt-8 max-w-[30em] leading-8 text-center sm:text-base sm:leading-9">
        わんわんとリストは、<br>
        すべての人に適したアプリではありません。
      </p>

    </div>

    <%# ==========================================
        こんな方におすすめ
    ========================================== %>
    <div class="mx-auto mt-10 max-w-3xl rounded-3xl bg-white px-5 py-8 shadow-sm sm:px-10 sm:py-10">

      <h3 class="text-center text-lg font-bold sm:text-xl">
        こんな方におすすめ
      </h3>

      <div
        class="mx-auto mt-5 h-px w-12 bg-[#A8BFA0]"
        aria-hidden="true"
      ></div>

      <%# おすすめする3つの人物像 %>
      <div class="mt-10 space-y-10">

        <% [
          {
            icon: "icons/small_step.png",
            title: "毎日に、少し変化がほしい方",
            descriptions: [
              "仕事や日々の生活に追われ、気づけば同じことの繰り返し。",
              "新しいことを始めたいけれど、何から始めればいいかわからず、なかなか行動に移せない。",
              "まずは小さなことから、自分の「やりたい」を見つけていきたい。"
            ]
          },
          {
            icon: "icons/want_notebook.png",
            title: "やりたいことリストが続かなかった方",
            descriptions: [
              "やりたいことを書き出すのは、大切だとわかっている。",
              "一度は始めてみたけれど、忙しかったり、「今日はいいか」と後回しにしたりして、いつの間にかやめていた。",
              "今度は無理せず、自分と向き合う時間を少しずつつくりたい。"
            ]
          },
          {
            icon: "icons/break_time.png",
            title: "完璧にやろうとして、疲れてしまう方",
            descriptions: [
              "やろうと決めたら、ついがんばりすぎてしまう。",
              "でも、完璧にやろうとして、いつの間にか疲れて、続けることが負担になってしまう。",
              "もっと気楽に、がんばりすぎずに、自分のペースで取り組んでいきたい。"
            ]
          }
        ].each do |item| %>

          <div class="flex items-start gap-3 sm:gap-5">

            <%# トップページと共通のイラスト %>
            <%= image_tag item[:icon],
                          alt: "",
                          loading: "lazy",
                          class: "mt-1 h-14 w-14 shrink-0 object-contain sm:h-18 sm:w-18" %>

            <%# 見出し・説明文 %>
            <div class="min-w-0 flex-1">

              <h4 class="text-sm font-bold leading-7 sm:text-base">
                <%= item[:title] %>
              </h4>

              <p class="mt-2 text-sm leading-7 text-[#4F5A4C]/80 sm:leading-8">
                <%= safe_join(item[:descriptions], tag.br) %>
              </p>

            </div>

          </div>

        <% end %>

      </div>

      <%# 補足：ほかにもおすすめの方 %>
      <div class="mt-10 border-t border-[#A8BFA0]/40 pt-8">

        <h4 class="text-sm font-bold leading-7 sm:text-base">
          ほかにも、こんな方におすすめです。
        </h4>

        <ul class="mt-4 list-disc space-y-0 pl-5 text-sm leading-7 text-[#4F5A4C]/80 sm:leading-8">
          <li>
            ノートや手帳を買ったり、アプリをダウンロードしただけで満足してしまったことがある方
          </li>
          <li>
            まじめで、何事にも、ついがんばりすぎてしまう方
          </li>
          <li>
            仕事から帰ると疲れて、スマホを見ているうちに一日が終わってしまい、自分と向き合う時間が取れない方
          </li>
          <li>
            何もしない時間も好きだけど、何か新しいこともしてみたい方
          </li>
        </ul>

      </div>

    </div>

    <%# ==========================================
        こんな方には、少し物足りないかも
    ========================================== %>
    <div class="mx-auto mt-6 max-w-3xl rounded-3xl bg-[#F6F5EE] px-5 py-8 shadow-sm sm:px-10 sm:py-10">

      <h3 class="text-center text-lg font-bold leading-relaxed sm:text-xl">
        こんな方には、<br class="sm:hidden">
        少し物足りないかも
      </h3>

      <div
        class="mx-auto mt-5 h-px w-12 bg-[#A8BFA0]"
        aria-hidden="true"
      ></div>

      <%# 適していない可能性がある3つの人物像 %>
      <div class="mt-10 space-y-9">

        <% [
          {
            title: "やりたいことを、どんどん登録したい方",
            descriptions: [
              "思いついたことを、その場でたくさん書きとめたい。",
              "1日ひとつまでしか登録できないため、思い付いたものをたくさん登録したい方には適していないかもしれません。"
            ]
          },
          {
            title: "目標を細かく管理したい方",
            descriptions: [
              "目標を細かなタスクに分け、スケジュールや進捗を詳細に管理したい。",
              "わんわんとリストは、効率的な目標管理よりも、長期的に、ゆっくりと自分の「やりたい」と向き合うことを大切にしています。"
            ]
          },
          {
            title: "すでに、自分に合う方法がある方",
            descriptions: [
              "ほかのアプリやノートで、無理なく継続できている。",
              "自分なりのペースや習慣が、すでに身についている。",
              "「1日ひとつ」という仕組みが、かえって窮屈に感じられるかもしれません。"
            ]
          }
        ].each do |item| %>

          <div class="border-l-2 border-[#A8BFA0] pl-4 sm:pl-5">

            <h4 class="text-sm font-bold leading-7 sm:text-base">
              <%= item[:title] %>
            </h4>

            <p class="mt-2 text-sm leading-7 text-[#4F5A4C]/80 sm:leading-8">
              <%= safe_join(item[:descriptions], tag.br) %>
            </p>

          </div>

        <% end %>

      </div>

      <%# 補足：ほかにも適していない可能性がある方 %>
      <div class="mt-10 border-t border-[#A8BFA0]/40 pt-8">

        <h4 class="text-sm font-bold leading-7 sm:text-base">
          ほかにも、こんな方には合わないかもしれません。
        </h4>

        <ul class="mt-4 list-disc space-y-0 pl-5 text-sm leading-7 text-[#4F5A4C]/80 sm:leading-8">
          <li>
            やりたいことや目標が明確で、自分なりに行動できている方
          </li>
          <li>
            書き出すよりも、思いついたらすぐ行動するほうが合っている方
          </li>
          <li>
            ほかのやりたいことリストアプリを、無理なく続けられている方
          </li>
          <li>
            ノートや手帳に書く習慣が、すでに身についている方
          </li>
        </ul>

        <div class="mt-8 space-y-3 text-sm leading-8 text-[#4F5A4C]/80">
          <p>
            すでに自分に合った方法があるなら、無理に変える必要はありません。<br>
            大切なのは、自分に合った方法で、自分の「やりたい」と向き合うことだと思います。
          </p>
         </div>

      </div>
    </div>

    <%# ==========================================
        締めのメッセージ
    ========================================== %>
    <div class="mt-12 text-center">

      <div
        class="mx-auto h-px w-12 bg-[#A8BFA0]"
        aria-hidden="true"
      ></div>

      <p class="mt-8 text-lg font-bold leading-relaxed sm:text-xl">
        自分に合ったペースが、いちばん。
      </p>

      <p class="mt-4 text-sm leading-8 sm:text-base">
        今のあなたに、ちょうどよさそう。<br>
        そう感じたら、気軽に試してみてください。
      </p>

    </div>

  </div>
</section>
