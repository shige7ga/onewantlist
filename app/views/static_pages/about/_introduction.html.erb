<%# ============================================
    Introduction：コンセプト説明
============================================ %>
<section
  id="introduction"
  aria-labelledby="introduction-title"
  class="px-5 py-18 sm:py-20"
>
  <div class="mx-auto max-w-3xl text-center">

    <%# 小見出し %>
    <span class="inline-block rounded-full bg-[#A8BFA0]/30 px-4 py-1 text-xs font-bold tracking-widest text-[#4F5A4C]">
      ABOUT
    </span>

    <%# ページタイトル %>
    <h1
      id="introduction-title"
      class="mt-5 text-3xl font-bold sm:text-4xl"
    >
      わんわんとリストとは？
    </h1>

    <p class="mt-3 text-sm font-medium text-[#7D9876]">
      「やってみたい」を、ひとつずつ。
    </p>

    <%= render "static_pages/shared/characters",
           image: "wanta_risumaru.png",
           alt: "ワン太とリス丸" %>

    <%# アプリ紹介 %>
    <div class="mx-auto mt-6 max-w-xl space-y-4 text-sm leading-8 sm:text-base">

      <p>
        わんわんとリストは、<br>
        1日ひとつ「やりたいこと」を書きとめるアプリです。
      </p>

      <p>
        あなたの「やってみたい」という気持ちを、<br>
        少しずつ集めていきましょう。
      </p>

    </div>

  </div>
</section>
