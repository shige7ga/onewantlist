<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center bg-[#F6F5EE] px-4 py-10">
  <div class="card w-full max-w-lg rounded-3xl bg-white shadow-xl">
    <div class="card-body gap-6">

      <%# タイトル %>
      <div class="text-center">
        <h2 class="text-2xl font-bold text-[#4F5A4C]">
          やりたいことを編集
        </h2>

        <p class="mt-3 text-sm text-[#4F5A4C]/70">
          ガチャで提案された内容を自由に編集できます
        </p>
      </div>

      <%= render "shared/flash", flash: flash %>

      <%# 編集フォーム %>
      <%= form_with model: @want,
                    url: wants_path,
                    method: :post,
                    html: { class: "space-y-5" } do |f| %>

        <%= hidden_field_tag :registration_source, "gacha" %>

        <div>
          <%= f.text_area :content,
                          autofocus: true,
                          required: true,
                          maxlength: 400,
                          rows: 6,
                          class: "textarea textarea-bordered w-full border-[#A8BFA0] bg-[#F6F5EE] text-[#4F5A4C] focus:border-[#4F5A4C] focus:outline-none" %>

          <%# バリデーションエラー %>
          <% @want.errors.full_messages_for(:content).each do |message| %>
            <p class="mt-2 text-sm text-red-600" role="alert">
              <%= message %>
            </p>
          <% end %>
        </div>

        <%# 操作ボタン %>
        <div class="grid grid-cols-2 gap-3">

          <%= link_to "戻る",
                      random_want_path,
                      class: "btn h-12 rounded-full border border-[#A8BFA0] bg-white text-[#4F5A4C] hover:bg-[#F6F5EE]" %>

          <%= f.submit "登録する",
                       class: "btn h-12 rounded-full border-none bg-[#A8BFA0] font-bold text-[#354133] hover:bg-[#96AE8E]" %>

        </div>
      <% end %>

    </div>
  </div>
</div>
