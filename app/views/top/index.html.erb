<% events = status_events.map(&:with_indifferent_access) %>

<%
  first_visit_level_up_event =
    events.find do |event|
      event[:type] == "lv_up" &&
        event[:source] == "first_visit"
    end
%>

<% if first_visit_level_up_event %>
  <%= render "shared/level_up_modal",
            event: first_visit_level_up_event,
            content_partial: "shared/level_up/first_visit_content",
            delay: 800,
            hero_intro_lock: true %>
<% end %>

<main class="bg-[#F6F5EE] text-[#4F5A4C]">

  <%= render "top/sections/hero" %>
  <%= render "top/sections/features" %>
  <%= render "top/sections/philosophy" %>
  <%= render "top/sections/story" %>
  <%= render "top/sections/target_users" %>
  <%= render "top/sections/cta" %>

</main>
