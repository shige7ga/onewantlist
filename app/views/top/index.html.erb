<div class="hero min-h-screen bg-[#F6F5EE]">
  <div class="hero-content text-center">
    <div class="max-w-xl">
      <h1 class="mb-4 text-5xl font-bold text-[#4F5A4C]">
        わんわんとリスト
      </h1>

      <p class="text-lg text-gray-600">
        1日1つだけ「やりたいこと」を登録して、<br>
        小さな一歩を積み重ねよう。
      </p>

      <div class="mt-6 flex justify-center gap-3">
        <%= link_to "ユーザー登録",
                    new_user_registration_path,
                    class: "btn border-[#A8BFA0] bg-[#A8BFA0] text-[#4F5A4C] hover:bg-[#A8BFA0]/80" %>
        <%= link_to "ログイン",
                    new_user_session_path,
                    class: "btn btn-outline border-[#A8BFA0] text-[#4F5A4C] hover:border-[#A8BFA0] hover:bg-[#A8BFA0]/30" %>
      </div>
    </div>
  </div>
</div>
