<% owner = current_owner %>
<% status = owner.user_status %>
<% is_guest = !user_signed_in? %>

<%# 今日のやりたいこと登録状況 %>
<% today_registered = status.last_want_registration_date == Date.current %>

<%# 通常のガチャ抽選が可能か %>
<% can_draw_gacha = !today_registered && status.random_gacha_available? %>

<%# ガチャの遷移先・リクエスト方法 %>
<% gacha_path = can_draw_gacha ? draw_random_want_path : random_want_path %>

<% gacha_data = can_draw_gacha ? { turbo_method: :post } : {} %>

<div class="fixed bottom-0 left-1/2 z-40
            w-full -translate-x-1/2
            md:w-1/2 md:max-w-2xl
            border-t border-gray-200
            bg-color
            p-3 shadow-[0_-4px_12px_rgba(0,0,0,0.08)]">

  <div class="grid grid-cols-2 gap-3">

    <%# 自由登録ボタン %>
    <%= render "shared/main_page/action_bar_item",
          label: "＋ やりたいこと登録",
          icon: nil,
          is_guest: is_guest,
          limited: guest_action_limited?(:direct),
          remaining: is_guest ? owner.remaining_direct_registrations : nil,
          limit: GuestUser::DIRECT_REGISTRATION_LIMIT,
          limit_type: "direct",
          path: new_want_path,
          link_data: {},
          extra_class: nil %>

    <%# ガチャボタン %>
    <%= render "shared/main_page/action_bar_item",
          label: "やりたいことガチャ",
          icon: "icons/gacha_button.svg",
          is_guest: is_guest,
          limited: guest_action_limited?(:gacha),
          remaining: is_guest ? owner.remaining_gacha_usages : nil,
          limit: GuestUser::GACHA_USAGE_LIMIT,
          limit_type: "gacha",
          path: gacha_path,
          link_data: gacha_data,
          extra_class: "gap-0.5 bg-[#E3C88F]" %>

  </div>
</div>
