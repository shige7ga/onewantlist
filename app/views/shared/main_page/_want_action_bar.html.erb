
<% owner = current_owner %>
<% status = owner.user_status %>
<% guest = !user_signed_in? %>

<%# 今日のやりたいこと登録状況 %>
<% today_registered =
  status.last_want_registration_date == Date.current
%>

<%# 自由登録のゲスト利用制限 %>
<% direct_limited =
  guest && !owner.direct_registration_available?
%>

<%# ガチャのゲスト利用制限 %>
<% gacha_limited =
  guest &&
  !owner.gacha_usage_available? &&
  (status.random_gacha_date != Date.current || today_registered)
%>

<%# 通常のガチャ抽選が可能か %>
<% can_draw_gacha =
  !today_registered && status.random_gacha_available?
%>

<%# ガチャの遷移先・リクエスト方法 %>
<% gacha_path =
  can_draw_gacha ? draw_random_want_path : random_want_path
%>

<% gacha_data =
  can_draw_gacha ? { turbo_method: :post } : {}
%>

<div class="fixed bottom-0 left-1/2 z-40
            w-full -translate-x-1/2
            md:w-1/2 md:max-w-2xl
            border-t border-gray-200
            bg-[#F6F5EE]
            p-3 shadow-[0_-4px_12px_rgba(0,0,0,0.08)]">

  <div class="grid grid-cols-2 gap-3">

    <%# ========================================
        やりたいこと自由登録
    ======================================== %>

    <% if direct_limited %>

      <%# ゲスト利用制限到達：モーダル表示 %>
      <button
        type="button"
        data-action="guest-limit-modal#open"
        data-guest-limit-type="direct"
        class="flex flex-col items-center justify-center
               rounded-xl bg-[#A8BFA0]
               px-3 py-3
               font-bold text-[#4F5A4C]
               hover:opacity-80"
      >
        <span class="whitespace-nowrap">
          ＋ やりたいこと登録
        </span>

        <span class="text-[10px] font-normal leading-none">
          （残り 0 / <%= GuestUser::DIRECT_REGISTRATION_LIMIT %> 回）
        </span>
      </button>

    <% else %>

      <%# 通常の登録画面へ %>
      <%= link_to new_want_path,
            class: "flex flex-col items-center justify-center
                    rounded-xl bg-[#A8BFA0]
                    px-3 py-3
                    font-bold text-[#4F5A4C]
                    hover:opacity-80" do %>

        <span class="whitespace-nowrap">
          ＋ やりたいこと登録
        </span>

        <% if guest %>
          <span class="text-[10px] font-normal leading-none">
            （残り <%= owner.remaining_direct_registrations %> /
            <%= GuestUser::DIRECT_REGISTRATION_LIMIT %> 回）
          </span>
        <% end %>

      <% end %>

    <% end %>


    <%# ========================================
        やりたいことガチャ
    ======================================== %>

    <% if gacha_limited %>

      <%# ゲスト利用制限到達：モーダル表示 %>
      <button
        type="button"
        data-action="guest-limit-modal#open"
        data-guest-limit-type="gacha"
        class="flex flex-col items-center justify-center
               gap-0.5
               rounded-xl bg-[#E3C88F]
               px-3 py-3
               font-bold text-[#4F5A4C]
               hover:opacity-80"
      >

        <span class="flex items-center justify-center gap-1.5">
          <%= image_tag "icons/gacha_button.svg",
                        alt: "",
                        class: "w-4 h-4 shrink-0" %>

          <span class="whitespace-nowrap">
            やりたいことガチャ
          </span>
        </span>

        <span class="text-[10px] font-normal leading-none">
          （残り 0 / <%= GuestUser::GACHA_USAGE_LIMIT %> 回）
        </span>

      </button>

    <% else %>

      <%# 通常のガチャ処理 %>
      <%= link_to gacha_path,
            data: gacha_data,
            class: "flex flex-col items-center justify-center
                    gap-0.5
                    rounded-xl bg-[#E3C88F]
                    px-3 py-3
                    font-bold text-[#4F5A4C]
                    hover:opacity-80" do %>

        <span class="flex items-center justify-center gap-1.5">
          <%= image_tag "icons/gacha_button.svg",
                        alt: "",
                        class: "w-4 h-4 shrink-0" %>

          <span class="whitespace-nowrap">
            やりたいことガチャ
          </span>
        </span>

        <% if guest %>
          <span class="text-[10px] font-normal leading-none">
            （残り <%= owner.remaining_gacha_usages %> /
            <%= GuestUser::GACHA_USAGE_LIMIT %> 回）
          </span>
        <% end %>

      <% end %>

    <% end %>

  </div>
</div>
