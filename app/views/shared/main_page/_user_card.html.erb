<div class="card border border-[#A8BFA0]/30 bg-white shadow-md">
  <div class="card-body gap-4 p-5">

    <%# ヘッダー %>
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-base font-bold text-[#4F5A4C]">
        マイステータス
      </h2>

      <%# ステータス詳細画面の実装後にリンクへ変更 %>
      <%= link_to "詳細を見る ›",
            status_path,
            class: "text-xs font-semibold text-[#7D9876] hover:underline" %>
    </div>

    <% if user_status.present? %>

      <%# レベル・経験値 %>
      <div class="flex items-center gap-3">

        <%# レベルアイコン %>
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#A8BFA0]">
          <span class="text-xl text-white">
            ★
          </span>
        </div>

        <div class="min-w-0 flex-1">
          <%# 現在のレベル %>
          <p class="text-lg font-bold text-[#4F5A4C]">
            Lv. <%= user_status.level %>
          </p>

          <%# 経験値ゲージ %>
          <% required_exp = user_status.required_exp_for_next_level %>
          <% current_exp = user_status.current_level_exp %>
          <% progress = (current_exp.to_f / required_exp * 100).clamp(0, 100) %>

          <div
            class="mt-1 h-2.5 w-full overflow-hidden
                   rounded-full bg-[#A8BFA0]/20"
            role="progressbar"
            aria-label="次のレベルまでの経験値"
            aria-valuenow="<%= current_exp %>"
            aria-valuemin="0"
            aria-valuemax="<%= required_exp %>"
          >

            <div
              class="h-full rounded-full bg-[#8EAD86] transition-all"
              style="width: <%= progress %>%"
            ></div>

          </div>

          <%# 次のレベルまでの残りEXP %>
          <p class="mt-1 text-xs text-[#4F5A4C]/70">
            次のレベルまで
            <%= user_status.exp_to_next_level %> EXP
          </p>

        </div>
      </div>

    <% else %>

      <p class="text-sm text-[#4F5A4C]/70">
        ステータス情報がありません
      </p>

    <% end %>

  </div>
</div>
