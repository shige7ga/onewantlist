<div class="app-card">
  <div class="card-body gap-3 p-3 sm:p-4">

    <%# タイトル・ユーザー名・詳細リンク %>
    <div class="flex items-center gap-2">

      <div class="flex min-w-0 items-center gap-2 lg:flex-col lg:items-start lg:gap-0">
        <h2 class="shrink-0 text-base font-bold">
          マイステータス
        </h2>

        <span class="min-w-0 max-w-24 truncate text-xs text-sub-text lg:max-w-full">
          <%= user.name.presence || "未登録" %>
        </span>
      </div>

      <%= link_to "詳細を見る ›",
                  status_path,
                  class: "simple-btn ml-auto min-h-0 shrink-0 bg-soft-green px-3 py-1 text-xs hover:bg-app-accent" %>
    </div>

    <%# 経験値・アニメーション情報 %>
    <% current_exp = user_status.current_level_exp %>
    <% required_exp = user_status.required_exp_for_next_level %>

    <% animation = user_status.exp_gauge_animation(events) %>

    <% start_level = animation ? animation[:start_level] : user_status.level %>
    <% start_exp = animation ? animation[:start_exp] : current_exp %>
    <% requirements = animation ? animation[:requirements] : [required_exp] %>

    <% initial_required = requirements.first %>
    <% initial_progress = (start_exp.to_f / initial_required * 100).clamp(0, 100) %>

    <%# レベル・EXPゲージ・アニメーション %>
    <div
      class="space-y-2"
      data-controller="exp-gauge"
      data-action="level-up-modal:closed@window->exp-gauge#resume"
      data-exp-gauge-play-value="<%= animation.present? %>"
      data-exp-gauge-start-level-value="<%= start_level %>"
      data-exp-gauge-start-exp-value="<%= start_exp %>"
      data-exp-gauge-requirements-value="<%= requirements.to_json %>"
      data-exp-gauge-final-level-value="<%= user_status.level %>"
      data-exp-gauge-final-exp-value="<%= current_exp %>"
    >

      <%# 肉球・レベル・登録状況・EXPゲージ %>
      <div class="flex items-center gap-2">

        <%# 肉球アイコン %>
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-app-accent">
          <%= image_tag "icons/paws_white.png",
                        alt: "",
                        class: "h-8 w-8 object-contain" %>
        </div>

        <%# レベル %>
        <div class="flex shrink-0 items-baseline gap-1 text-color">

          <span class="text-sm font-medium">
            Lv.
          </span>

          <span
            data-exp-gauge-target="level"
            class="text-4xl font-bold leading-none tabular-nums"
          >
            <%= start_level %>
          </span>

        </div>

        <%# 登録状況・EXPゲージ %>
        <div class="min-w-0 flex-1 space-y-1">

          <%# 登録状況・残りEXP %>
          <div class="flex flex-wrap items-center justify-between gap-x-1 gap-y-0.5">

            <% if user_status.last_want_registration_date == Date.current %>
              <span class="inline-flex shrink-0 items-center whitespace-nowrap rounded-full border border-app-accent bg-soft-green px-1.5 py-0.5 text-[10px] font-semibold text-[#4F7953]">
                ✓ 本日登録済
              </span>
            <% else %>
              <span class="inline-flex shrink-0 items-center whitespace-nowrap rounded-full border border-dashed border-[#BBC7B7] px-1.5 py-0.5 text-[10px] font-medium text-[#7D8978]">
                ○ 今日は未登録
              </span>
            <% end %>

            <span class="ml-auto whitespace-nowrap text-[10px] text-color/70">
              あと
              <span data-exp-gauge-target="remaining">
                <%= initial_required - start_exp %>
              </span>
              EXP
            </span>

          </div>

          <%# EXPゲージ %>
          <div
            data-exp-gauge-target="progress"
            class="h-2.5 w-full overflow-hidden rounded-full bg-app-accent/20"
            role="progressbar"
            aria-label="次のレベルまでの経験値"
            aria-valuenow="<%= start_exp %>"
            aria-valuemin="0"
            aria-valuemax="<%= initial_required %>"
          >
            <div
              data-exp-gauge-target="bar"
              class="h-full rounded-full bg-[#8EAD86]"
              style="width: <%= initial_progress %>%"
            ></div>
          </div>

        </div>
      </div>

      <%# Stimulusの既存ターゲットを維持 %>
      <span data-exp-gauge-target="current" class="hidden">
        <%= start_exp %>
      </span>

      <span data-exp-gauge-target="required" class="hidden">
        <%= initial_required %>
      </span>

      <%# EXP獲得メッセージ %>
      <% gain_messages = exp_gain_messages(events) %>

      <div
        data-exp-gauge-target="earned"
        class="<%= 'hidden' unless animation %> rounded-lg bg-soft-green px-2 py-1.5 text-center text-xs font-semibold text-sub-text"
        role="status"
      >
        <% gain_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>

    </div>

    <%# 利用記録 %>
    <div class="grid grid-cols-4 gap-1 border-t border-app-accent/20 pt-3 text-center lg:grid-cols-2 lg:gap-2">

      <% [
        ["ログイン数", user_status.login_count || 0, "日"],
        ["アクション数", user_status.action_count || 0, "日"],
        ["登録数", wants.size, "件"],
        ["達成数", wants.count(&:completed?), "件"]
      ].each do |label, value, unit| %>

        <div class="min-w-0">
          <p class="text-[10px] text-color/70">
            <%= label %>
          </p>

          <%= tag.p(
                id: ("completed-wants-count" if label == "達成数"),
                class: "text-lg font-bold tabular-nums"
              ) do %>
            <%= value %><span class="text-xs font-normal"><%= unit %></span>
          <% end %>
        </div>

      <% end %>
    </div>
  </div>
</div>
