<div class="card border border-[#A8BFA0]/30 bg-white shadow-md">
  <div class="card-body gap-4 p-5">

    <%# ヘッダー %>
    <div class="flex items-start justify-between gap-3">

      <%# タイトルと本日の登録状況 %>
      <div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">

        <h2 class="text-base font-bold text-[#4F5A4C]">
          マイステータス
        </h2>

        <% if user_status.present? %>
          <% if user_status.last_want_registration_date == Date.current %>

            <%# 登録済み：グリーンのバッジ %>
            <span
              class="inline-flex items-center gap-1
                    whitespace-nowrap rounded-full
                    border border-[#A8BFA0]
                    bg-[#EAF2E7]
                    px-2 py-0.5
                    text-[10px] font-semibold text-[#4F7953]"
            >
              <span aria-hidden="true">✓</span>
              本日登録済
            </span>

          <% else %>

            <%# 未登録：点線・背景色なし %>
            <span
              class="inline-flex items-center gap-1
                    whitespace-nowrap rounded-full
                    border border-dashed border-[#BBC7B7]
                    bg-transparent
                    px-2 py-0.5
                    text-[10px] font-medium text-[#7D8978]"
            >
              <span aria-hidden="true">○</span>
              今日は未登録
            </span>

          <% end %>
        <% end %>
      </div>

      <%# ステータス詳細へのリンク %>
      <%= link_to "詳細を見る ›",
                  status_path,
                  class: "shrink-0 whitespace-nowrap text-xs font-semibold text-[#7D9876] hover:underline" %>
    </div>

    <% if user_status.present? %>

      <%# レベル・経験値 %>
      <div class="flex items-center gap-3">

        <%# レベルアイコン %>
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#A8BFA0]">
          <%= image_tag "icons/paws_white.png",
                        alt: "",
                        class: "h-8 w-8 object-contain" %>
        </div>

        <div class="min-w-0 flex-1">

          <%# 現在の経験値情報 %>
          <% current_exp = user_status.current_level_exp %>
          <% required_exp = user_status.required_exp_for_next_level %>

          <%# アニメーションデータを取得 %>
          <% animation = user_status.exp_gauge_animation(events) %>

          <%# アニメーションがあれば更新前の値を初期表示 %>
          <% start_level = animation ? animation[:start_level] : user_status.level %>
          <% start_exp = animation ? animation[:start_exp] : current_exp %>
          <% requirements = animation ? animation[:requirements] : [required_exp] %>

          <% initial_required = requirements.first %>
          <% initial_progress = (start_exp.to_f / initial_required * 100).clamp(0, 100) %>

          <div
            data-controller="exp-gauge"
            data-action="level-up-modal:closed@window->exp-gauge#resume"
            data-exp-gauge-play-value="<%= animation.present? %>"
            data-exp-gauge-start-level-value="<%= start_level %>"
            data-exp-gauge-start-exp-value="<%= start_exp %>"
            data-exp-gauge-requirements-value="<%= requirements.to_json %>"
            data-exp-gauge-final-level-value="<%= user_status.level %>"
            data-exp-gauge-final-exp-value="<%= current_exp %>"
          >

            <%# レベルと獲得経験値 %>
            <div class="flex items-center justify-between gap-2">

              <p
                data-exp-gauge-target="level"
                class="text-lg font-bold text-[#4F5A4C]"
              >
                Lv. <%= start_level %>
              </p>

              <% gain_messages = exp_gain_messages(events) %>

              <div
                data-exp-gauge-target="earned"
                class="<%= 'hidden' unless animation %> text-right text-xs font-bold text-[#7D9876]"
                role="status"
              >
                <% gain_messages.each do |message| %>
                  <p><%= message %></p>
                <% end %>
              </div>

            </div>

            <%# 経験値ゲージ %>
            <div
              data-exp-gauge-target="progress"
              class="mt-1 h-2.5 w-full overflow-hidden
                    rounded-full bg-[#A8BFA0]/20"
              role="progressbar"
              aria-label="次のレベルまでの経験値"
              aria-valuenow="<%= start_exp %>"
              aria-valuemin="0"
              aria-valuemax="<%= initial_required %>"
            >
              <div
                data-exp-gauge-target="bar"
                class="h-full rounded-full bg-[#8EAD86]"
                style="width: <%= initial_progress %>%"
              ></div>
            </div>

            <%# 現在EXP / 必要EXP / 残りEXP %>
            <div class="mt-1 flex flex-wrap justify-between gap-x-2 text-xs text-[#4F5A4C]/70">

              <span>
                <span data-exp-gauge-target="current">
                  <%= start_exp %>
                </span>
                /
                <span data-exp-gauge-target="required">
                  <%= initial_required %>
                </span>
                EXP
              </span>

              <span>
                あと
                <span data-exp-gauge-target="remaining">
                  <%= initial_required - start_exp %>
                </span>
                EXP
              </span>

            </div>
          </div>
        </div>
      </div>

    <% else %>

      <p class="text-sm text-[#4F5A4C]/70">
        ステータス情報がありません
      </p>

    <% end %>

  </div>
</div>
