<%# 今回獲得したEXPイベントを取得 %>
<% events = status_events.map(&:with_indifferent_access) %>

<%# ゲスト向けのモーダル設定 %>
<% guest_page = !user_signed_in? %>

<%# 自動表示：両方の体験が完全に終了した場合 %>
<% auto_show_limit = guest_page && user.experience_finished? %>

<%# EXP演出の実行有無を判定 %>
<% wait_for_exp = guest_page && user_status.exp_gauge_animation(events).present? %>

<div
  class="min-h-screen bg-[#F6F5EE] px-4 py-6 pb-32 sm:px-6"

  <% if guest_page %>
    data-controller="guest-limit-modal"
    data-guest-limit-modal-auto-value="<%= auto_show_limit %>"
    data-guest-limit-modal-wait-for-exp-value="<%= wait_for_exp %>"
    data-guest-limit-modal-redirect-type-value="<%= @guest_limit_modal_type %>"
    data-action="exp-gauge:finished@window->guest-limit-modal#expFinished"
    data-guest-limit-modal-titles-value="<%= guest_limit_modal_titles.to_json %>"
  <% end %>
>

  <div class="mx-auto w-full max-w-6xl">

    <%# フラッシュメッセージ %>
    <%= render "shared/flash", flash: flash %>

    <%# 通常レベルアップ用モーダル %>
    <% events.select { |event| event[:type] == "lv_up" }.each do |event| %>
      <%= render "shared/level_up_modal",
                  event: event,
                  content_partial: "shared/level_up/default_content",
                  auto: false %>
    <% end %>

    <%# mome機能のテストとして一時的に配置 %>
    <%= link_to '簡易メモ', memo_path %>

    <%# マイページコンテンツ %>
    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-10">

      <aside class="min-w-0 lg:col-span-3 lg:col-start-8 lg:row-start-1">
        <%= render "shared/main_page/user_card",
                    user: user,
                    user_status: user_status,
                    events: events %>
      </aside>

      <main class="min-w-0 lg:col-span-7 lg:col-start-1 lg:row-start-1">
        <%= render "wants/index", wants: wants %>
      </main>

    </div>
  </div>

  <%# 下部アクションバー %>
  <%= render "shared/main_page/want_action_bar" %>

  <%# ゲスト専用モーダル %>
  <% if guest_page %>
    <%= render "shared/guest_limit_modal" %>
  <% end %>

</div>
