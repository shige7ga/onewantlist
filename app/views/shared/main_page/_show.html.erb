<div class="min-h-screen bg-[#F6F5EE] p-6 pb-32">
  <div class="w-full max-w-md">
    <%# フラッシュメッセージ %>
    <%= render "shared/flash", flash: flash %>

    <%# 経験値UP・レベルアップなど %>
