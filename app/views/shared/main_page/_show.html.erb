<div class="min-h-screen bg-[#F6F5EE] px-4 py-6 pb-32 sm:px-6">
  <div class="mx-auto w-full max-w-6xl">

    <%# フラッシュメッセージ %>
    <%= render "shared/flash", flash: flash %>

    <%# 今回獲得した経験値イベントを取得（Sessionから削除） %>
    <% events = status_events.map(&:with_indifferent_access) %>

    <%# 通常レベルアップ用モーダル %>
    <% events.select { |event| event[:type] == "lv_up" }.each do |event| %>
      <%= render "shared/level_up_modal",
                  event: event,
                  content_partial: "shared/level_up/default_content",
                  auto: false %>
    <% end %>

    <%# マイページコンテンツ %>
    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-10">

      <%# ユーザーステータス %>
      <aside class="min-w-0 lg:col-span-3 lg:col-start-8 lg:row-start-1">
        <%= render "shared/main_page/user_card",
                    user: user,
                    user_status: user_status,
                    events: events %>
      </aside>

      <%# やりたいこと一覧 %>
      <main class="min-w-0 lg:col-span-7 lg:col-start-1 lg:row-start-1">
        <%= render "wants/index", wants: wants %>
      </main>

    </div>
  </div>

  <%# 画面下部の固定アクションバー %>
  <%= render "shared/main_page/want_action_bar" %>
</div>
