<header class="fixed inset-x-0 top-0 z-50 h-16 border-b border-app-accent bg-color">
  <div class="mx-auto flex h-full items-center justify-between gap-2 px-3 sm:px-6">

    <%# アプリ名：ロゴ画像＋文字 %>
    <%= link_to root_path,
                class: "flex min-w-0 items-center gap-2 text-base font-bold hover:opacity-70 sm:text-xl" do %>

      <%# ロゴ画像 %>
      <%= image_tag "header_logo.png",
                    alt: "",
                    class: "h-9 w-9 shrink-0 object-contain" %>

      <%# アプリ名 %>
      <span class="truncate">
        <%= t("header.app_title") %>
      </span>

    <% end %>

    <nav class="flex shrink-0 items-center gap-2" aria-label="サイトメニュー">

      <%# ログイン前のみ無料登録ボタンを表示 %>
      <% unless user_signed_in? %>
        <%= link_to "無料登録",
                    new_user_registration_path,
                    class: "btn h-auto py-2 rounded-full border-none bg-app-accent text-color btn-motion" %>
      <% end %>

      <%# ハンバーガーメニュー %>
      <details class="dropdown dropdown-end">

        <summary
          class="btn btn-square btn-ghost cursor-pointer list-none text-color [&::-webkit-details-marker]:hidden"
          aria-label="メニュー"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </summary>

        <%# プルダウンの中身 %>
        <ul class="menu dropdown-content z-50 mt-2 w-64 max-w-[calc(100vw-1rem)] text-color rounded-xl border border-app-accent/30 bg-color p-2 shadow-xl">

          <% if user_signed_in? %>

            <%# ログイン後：マイメニュー %>
            <li class="menu-title mt-2">
              <span class="flex items-center gap-2 text-xs text-sub-text">
                マイメニュー
                <span class="h-px flex-1 bg-app-accent/50"></span>
              </span>
            </li>

            <% [
              ["マイページ", mypage_path],
              ["簡単メモ", memo_path],
              ["マイステータス", status_path],
              ["ユーザー設定", edit_user_registration_path]
            ].each do |label, path| %>
              <li>
                <%= link_to label, path %>
              </li>
            <% end %>

          <% else %>

            <%# ログイン前：アカウント %>
            <li class="menu-title mt-2">
              <span class="flex items-center gap-2 text-xs text-sub-text">
                アカウント
                <span class="h-px flex-1 bg-app-accent/50"></span>
              </span>
            </li>

            <li>
              <%= link_to "ログイン", new_user_session_path %>
            </li>

            <li>
              <%= link_to "ゲストページ", guest_user_path %>
            </li>

          <% end %>

          <%# ============================================
              共通メニュー
          ============================================ %>

          <%# 初めての方へ %>
          <li class="menu-title mt-2">
            <span class="flex items-center gap-2 text-xs text-sub-text">
              初めての方へ
              <span class="h-px flex-1 bg-app-accent/50"></span>
            </span>
          </li>

          <% [
            ["わんわんとリストって？", about_path],
            ["使い方ガイド", guide_path]
          ].each do |label, path| %>
            <li>
              <%= link_to label, path %>
            </li>
          <% end %>

          <%# ご案内・サポート %>
          <li class="menu-title mt-3">
            <span class="flex items-center gap-2 text-xs text-sub-text">
              ご案内・サポート
              <span class="h-px flex-1 bg-app-accent/50"></span>
            </span>
          </li>

          <% [
            ["利用規約", terms_path],
            ["プライバシーポリシー", privacy_path],
            ["お問い合わせ", contact_path]
          ].each do |label, path| %>
            <li>
              <%= link_to label, path %>
            </li>
          <% end %>

          <%# ログイン後のみログアウトを表示 %>
          <% if user_signed_in? %>
            <li>
              <hr class="my-2 border-app-accent/30">
            </li>

            <li>
              <%= link_to "ログアウト",
                          destroy_user_session_path,
                          data: { turbo_method: :delete } %>
            </li>
          <% end %>

        </ul>
      </details>

    </nav>
  </div>
</header>
