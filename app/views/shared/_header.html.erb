<header class="fixed inset-x-0 top-0 z-50 h-16 border-b border-[#A8BFA0] bg-[#F6F5EE]">
  <div class="mx-auto flex h-full items-center justify-between gap-2 px-3 sm:px-6">

    <%# アプリ名：ロゴ画像＋文字 %>
    <%= link_to root_path,
                class: "flex min-w-0 items-center gap-2 text-base font-bold text-[#4F5A4C] hover:opacity-70 sm:text-xl" do %>

      <%# ロゴ画像 %>
      <%= image_tag "header_logo.png",
                    alt: "",
                    class: "h-9 w-9 shrink-0 object-contain" %>

      <%# アプリ名 %>
      <span class="truncate">
        <%= t("header.app_title") %>
      </span>

    <% end %>

    <nav class="flex shrink-0 items-center gap-2" aria-label="サイトメニュー">

      <%# ログイン前のみ無料登録ボタンを表示 %>
      <% unless user_signed_in? %>
        <%= link_to "無料登録",
                    new_user_registration_path,
                    class: "btn btn-sm border-none bg-[#A8BFA0] text-[#4F5A4C] hover:bg-[#96AE8E]" %>
      <% end %>

      <%# ハンバーガーメニュー %>
      <details class="dropdown dropdown-end">

        <summary
          class="btn btn-square btn-ghost cursor-pointer list-none text-[#4F5A4C] [&::-webkit-details-marker]:hidden"
          aria-label="メニュー"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </summary>

        <%# プルダウンの中身 %>
        <ul class="menu dropdown-content z-50 mt-2 w-64 max-w-[calc(100vw-1rem)] rounded-xl border border-[#A8BFA0]/30 bg-[#F6F5EE] p-2 text-[#4F5A4C] shadow-xl">

          <% if user_signed_in? %>

            <li>
              <%= link_to "マイページ",
                          mypage_path %>
            </li>

            <li>
              <%= link_to "マイステータス",
                          status_path %>
            </li>

            <li>
              <%= link_to "ユーザー設定",
                          edit_user_registration_path %>
            </li>

          <% else %>

            <%# ログイン前 %>
            <li>
              <%= link_to "ログイン",
                          new_user_session_path %>
            </li>

          <% end %>

          <li>
            <hr class="my-2 border-[#A8BFA0]/30">
          </li>

          <%# 共通メニュー項目 %>
          <% [
            ["初めての方へ", about_path],
            ["利用規約", terms_path],
            ["プライバシーポリシー", privacy_path],
            ["お問い合わせ", contact_path]
          ].each do |label, path| %>
            <li>
              <%= link_to label, path %>
            </li>
          <% end %>

          <%# ログイン後のみログアウトを表示 %>
          <% if user_signed_in? %>
            <li>
              <hr class="my-2 border-[#A8BFA0]/30">
            </li>

            <li>
              <%= link_to "ログアウト",
                          destroy_user_session_path,
                          data: { turbo_method: :delete } %>
            </li>
          <% end %>

        </ul>
      </details>

    </nav>
  </div>
</header>
