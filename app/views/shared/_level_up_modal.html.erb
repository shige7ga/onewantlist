<div
  data-controller="level-up-modal"
  <% if local_assigns[:hero_intro_lock] %>
    data-hero-intro-lock="true"
  <% end %>
  data-level-up-modal-auto-value="<%= local_assigns.fetch(:auto, true) %>"
  data-level-up-modal-level-value="<%= event[:level] %>"
  data-level-up-modal-delay-value="<%= local_assigns.fetch(:delay, 1500) %>"
  data-action="exp-gauge:level-up@window->level-up-modal#show"
  class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/30 px-5"
  role="dialog"
  aria-modal="true"
  aria-label="レベルアップのお知らせ"
  aria-hidden="true"
>
  <%# メインボックス %>
  <div class="relative isolate w-full max-w-xl rounded-3xl bg-color px-4 py-8 text-center shadow-xl sm:px-6">

    <%# 共通背景 %>
    <%= render "shared/confetti_background" %>

    <%# 上段：キャラクターとメッセージ %>
    <div class="relative z-10 flex min-h-32 items-center justify-center">

      <%# 左：ワン太 %>
      <%= image_tag "wanta_congrats.png",
                    alt: "お祝いするワン太",
                    class: "absolute bottom-0 left-0 w-20 object-contain sm:w-24" %>

      <%# 中央：メッセージ %>
      <div class="relative z-10 mx-auto flex w-full min-w-0 flex-col items-center justify-center px-12 sm:px-24">

        <p class="text-sm font-bold tracking-wider text-[#8CA184]">
          LEVEL UP!
        </p>

        <div class="mt-3 flex flex-wrap items-baseline justify-center gap-2">
          <span class="text-base text-gray-400">
            Lv.<%= event[:level] - 1 %>
          </span>

          <span class="text-gray-400">→</span>

          <span class="text-3xl font-bold">
            Lv.<%= event[:level] %>
          </span>
        </div>

        <div class="mt-4 w-full text-sm leading-relaxed [overflow-wrap:anywhere]">
          <%= render content_partial, event: event %>
        </div>
      </div>

      <%# 右：リス丸 %>
      <%= image_tag "risumaru_congrats.png",
                    alt: "お祝いするリス丸",
                    class: "absolute bottom-0 right-0 w-12 object-contain sm:w-15" %>

    </div>

    <%# 下段：閉じるボタン %>
    <div class="relative z-10 mt-6 flex justify-center">
      <button
        type="button"
        data-action="level-up-modal#close"
        class="simple-btn shadow-md hover:shadow-lg motion-safe:hover:-translate-y-0.5"
      >
        閉じる
      </button>
    </div>

  </div>
</div>
