<% flash.each do |type, message| %>
  <% color_class =
    case type
    when "notice"
      "bg-soft-green border-app-accent text-color"
    when "alert"
      "bg-[#FAEFEB] border-[#D9A69B] text-[#985F54]"
    else
      "bg-color border-app-accent text-color"
    end
  %>

  <div
    class="alert mb-2 border rounded-xl shadow-sm <%= color_class %>"
    data-controller="flash"
    role="<%= type == 'alert' ? 'alert' : 'status' %>"
  >
    <%= message %>
  </div>
<% end %>
