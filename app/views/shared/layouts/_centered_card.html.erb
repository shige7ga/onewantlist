<% guest_page = !user_signed_in? %>

<div class="centered-page"
    <% if guest_page %>
      data-controller="guest-limit-modal"
      data-guest-limit-modal-titles-value="<%= guest_limit_modal_titles.to_json %>"
    <% end %>>

  <div class="relative w-full <%= max_width %>">

    <%# カード外側のヘッダー %>
    <div class="absolute inset-x-0 bottom-full mb-3
                flex items-center justify-between gap-2">

      <%# 戻るボタン %>
      <%= render "shared/back_btn",
                path: back_path,
                btn_name: back_label %>

      <%# 任意の右上リンク %>
      <% if local_assigns[:header_action].present? %>
        <% variant = header_action[:variant] %>
        <% is_gacha = variant == :gacha %>

        <%# ゲストの利用制限を判定 %>
        <% limit_type =
          variant if %i[direct gacha].include?(variant) &&
            guest_action_limited?(variant)
        %>

        <%# 種類によって背景色・枠線・ホバー色を変更 %>
        <% color_class = if is_gacha
                          "border-[#E3C88F] bg-[#E3C88F]/50 hover:bg-[#E3C88F]/70"
                        else
                          "border-app-accent bg-app-accent/50 hover:bg-app-accent/70"
                        end %>

        <%# ボタンの共通表示内容 %>
        <% button_content = capture do %>
          <span class="inline-flex shrink-0 items-center gap-1.5
                      rounded-full border px-3 py-1.5
                      text-xs font-medium text-color
                      transition-colors <%= color_class %>">

            <% if is_gacha %>
              <%= image_tag "icons/gacha_button.svg",
                            alt: "",
                            class: "h-4 w-4 shrink-0" %>
            <% else %>
              <span aria-hidden="true">＋</span>
            <% end %>

            <%= header_action[:label] %>
          </span>
        <% end %>

        <% if limit_type.present? %>
          <%# 制限中：遷移せずモーダルを表示 %>
          <%= button_tag type: "button",
                        data: {
                          action: "guest-limit-modal#open",
                          guest_limit_type: limit_type
                        } do %>
            <%= button_content %>
          <% end %>

        <% else %>
          <%# 利用可能：通常どおり遷移 %>
          <%= link_to header_action[:path], data: header_action[:data] do %>
            <%= button_content %>
          <% end %>
        <% end %>

      <% end %>

    </div>

    <%# カード本体 %>
    <div class="app-card">
      <%= yield %>
    </div>

  </div>

  <%# ゲスト体験制限モーダル %>
  <% if guest_page %>
    <%= render "shared/guest_limit_modal" %>
  <% end %>
</div>
