<% messages = form.object.errors.full_messages_for(attribute) %>

<% if messages.any? %>
  <div id="<%= "#{form.object_name}_#{attribute}_errors" %>"
       class="mt-1 space-y-1"
       role="alert">
    <% messages.each do |message| %>
      <p class="text-sm text-red-600">
        <%= message %>
      </p>
    <% end %>
  </div>
<% end %>
