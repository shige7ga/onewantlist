<footer
  class="border-t border-[#A8BFA0]/30 bg-[#F6F5EE] px-4 py-8 text-center <%= 'pb-28' if current_page?(mypage_path) || current_page?(guest_user_path) %>"
>
  <nav aria-label="フッター">
    <ul class="mx-auto flex max-w-4xl list-none flex-wrap justify-center gap-x-5 gap-y-2">

      <% [
        ["利用規約", terms_path],
        ["プライバシーポリシー", privacy_path],
        ["お問い合わせ", contact_path]
      ].each do |label, path| %>
        <li>
          <%= link_to label, path, class: "text-xs text-[#4F5A4C]/50" %>
        </li>
      <% end %>

    </ul>
  </nav>

  <p class="mt-5 text-xs text-[#4F5A4C]/50">
    &copy; <%= Time.current.year %> わんわんとリスト
  </p>
</footer>
