<%# カレンダー仮置き %>
<section class="app-card md:col-span-3">
  <div class="card-body h-full gap-2 p-3 sm:p-4">

    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-sm font-bold">
        登録カレンダー
      </h2>

      <p class="text-xs text-sub-text">
        今月の登録：
        <span class="font-bold text-color">
          <%= monthly_registration_count %> 件
        </span>
      </p>
    </div>

    <%# TODO: simple_calendar導入時に差し替え %>
    <div class="flex min-h-64 flex-1 items-center justify-center
                rounded-xl border border-dashed border-stone-300
                bg-transparent p-4 text-center
                lg:min-h-0 lg:p-2">

      <p class="text-xs text-sub-text">
        カレンダー表示エリア（後日実装）
      </p>

    </div>

  </div>
</section>
