<div class="px-4 pt-3 pb-6 sm:px-6">
  <div class="mx-auto w-full max-w-5xl space-y-3">

    <%# 戻るボタン・ページタイトル %>
    <div class="space-y-0">
      <%= render "shared/back_btn",
                 path: owner_home_path,
                 btn_name: "マイページに戻る" %>

      <h1 class="text-xl font-bold text-center leading-tight sm:text-2xl">
        マイステータス
      </h1>
    </div>

    <%# レベル・カレンダー %>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-5">

      <%= render "statuses/level_card",
                user_status: @user_status,
                owner: @owner %>

      <%# カレンダーをレベルカードの高さに合わせる %>
      <%= render "statuses/calender",
                monthly_registration_count: @monthly_registration_count %>

    </div>

    <%= render "statuses/records_of_login_and_action", user_status: @user_status %>
    <%= render "statuses/records_of_wants", want_counts: @want_counts %>

  </div>
</div>
