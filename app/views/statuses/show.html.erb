<div class="min-h-screen px-4 py-5 pb-12 sm:px-6">
  <div class="mx-auto w-full max-w-5xl space-y-4">

    <%= render "shared/back_btn",
               path: owner_home_path,
               btn_name: "マイページに戻る" %>

    <%# タイトル・ユーザー名 %>
    <div class="space-y-1 mb-2 -mt-2">
      <h1 class="text-2xl font-bold text-center">
        マイステータス
      </h1>

      <div class="flex items-center justify-end gap-2 px-1 text-sm">
        <span class="text-sub-text">ユーザー名：</span>
        <span class="font-semibold">
          <%= @owner.name.presence || "未登録" %>
        </span>

        <% if user_signed_in? %>
          <%= link_to edit_user_registration_path,
                      class: "simple-btn min-h-0 px-2 py-1 text-xs" do %>
            ✎ 編集
          <% end %>
        <% end %>
      </div>
    </div>

    <%# レベル・カレンダー %>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-5">
      <%= render "statuses/level_card", user_status: @user_status %>
      <%= render "statuses/calender", monthly_registration_count: @monthly_registration_count %>
    </div>

    <%= render "statuses/records_of_login_and_action", user_status: @user_status %>
    <%= render "statuses/records_of_wants", want_counts: @want_counts %>

  </div>
</div>
