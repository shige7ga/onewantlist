<%# レベル・経験値カード %>
<section class="app-card lg:col-span-2">
  <div class="card-body h-full items-center gap-4 p-5 text-center">

    <h2 class="text-sm font-bold">
      レベル・経験値
    </h2>

    <% current_exp = user_status.current_level_exp %>
    <% required_exp = user_status.required_exp_for_next_level %>
    <% progress = required_exp.positive? ? (current_exp.to_f / required_exp * 100).clamp(0, 100) : 0 %>

    <%# 円形経験値ゲージ %>
    <div
      class="radial-progress text-[#8EAD86]"
      style="--value:<%= progress %>; --size:13rem; --thickness:0.8rem;"
      role="progressbar"
      aria-label="次のレベルまでの経験値"
      aria-valuenow="<%= current_exp %>"
      aria-valuemin="0"
      aria-valuemax="<%= required_exp %>"
    >

      <div class="flex items-center justify-center text-color">
        <div class="relative -translate-y-1">
          <%# レベル数値：円の中央 %>
          <span class="block text-[72px] font-bold leading-none sm:text-[96px]">
            <%= user_status.level %>
          </span>

          <%# Lv.：数字の左下 %>
          <span class="absolute bottom-1 right-full mr-1 whitespace-nowrap text-xl font-medium sm:bottom-2 sm:text-2xl">
            Lv.
          </span>
        </div>
      </div>

    </div>

    <%# 次のレベルまで %>
    <p class="text-sm font-medium text-color">
      次のレベルまで
      <%= user_status.exp_to_next_level %> EXP
    </p>

    <%# 累計経験値：カード下部に補助表示 %>
    <div class="mt-auto w-full border-t border-stone-200 pt-3">
      <div class="flex items-center justify-center gap-2">
        <span class="text-xs text-sub-text">
          累計経験値
        </span>
        <span class="text-sm font-semibold">
          <%= number_with_delimiter(user_status.experience) %> EXP
        </span>
      </div>
    </div>

  </div>
</section>
