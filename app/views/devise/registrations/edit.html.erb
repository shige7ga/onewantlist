<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center bg-[#F6F5EE] px-4 py-8">
  <div class="card w-full max-w-md bg-white shadow-xl">
    <div class="card-body">
      <h2 class="card-title justify-center text-2xl font-bold text-[#4F5A4C]">
        <%= t(".title") %>
      </h2>
      <%= render "shared/flash", flash: flash %>

      <%= form_for(
            resource,
            as: resource_name,
            url: registration_path(resource_name),
            html: { method: :put, class: "space-y-4", novalidate: true }
          ) do |f| %>

        <% invalids = %i[name email password password_confirmation current_password].index_with do |attribute|
            f.object.errors[attribute].any?
          end %>

        <%# ユーザー名 %>
        <div>
          <%= f.label :name,
                      class: "mb-1 block text-sm font-semibold text-[#4F5A4C]" %>

          <%= f.text_field :name,
                          autofocus: true,
                          autocomplete: "nickname",
                          "aria-invalid": invalids[:name],
                          "aria-describedby": (f.field_id(:name, :errors) if invalids[:name]),
                          class: "input input-bordered w-full bg-[#F6F5EE] text-[#4F5A4C] #{invalids[:name] ? 'border-red-500' : 'border-[#A8BFA0]'} focus:outline-none" %>

          <%= render "shared/field_errors", form: f, attribute: :name %>
        </div>

        <%# メールアドレス %>
        <div>
          <%= f.label :email,
                      class: "mb-1 block text-sm font-semibold text-[#4F5A4C]" %>

          <%= f.email_field :email,
                            autofocus: true,
                            autocomplete: "email",
                            "aria-invalid": invalids[:email],
                            "aria-describedby": (f.field_id(:email, :errors) if invalids[:email]),
                            class: "input input-bordered w-full bg-[#F6F5EE] text-[#4F5A4C] #{invalids[:email] ? 'border-red-500' : 'border-[#A8BFA0]'} focus:outline-none" %>

          <%= render "shared/field_errors", form: f, attribute: :email %>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p class="mt-1 text-sm text-[#4F5A4C]/70">
              現在、<%= resource.unconfirmed_email %> の確認待ちです。
            </p>
          <% end %>
        </div>

        <%# 新しいパスワード %>
        <div>
          <div class="mb-1 flex items-center gap-2">
            <%= f.label :password, t(".new_password"),
                        class: "text-sm font-semibold text-[#4F5A4C]" %>
            <span class="text-xs text-[#4F5A4C]/70">
              <%= t(".blank_if_unchanged") %>
            </span>
          </div>

          <%= f.password_field :password,
                              autocomplete: "new-password",
                              "aria-invalid": invalids[:password],
                              "aria-describedby": (f.field_id(:password, :errors) if invalids[:password]),
                              class: "input input-bordered w-full bg-[#F6F5EE] text-[#4F5A4C] #{invalids[:password] ? 'border-red-500' : 'border-[#A8BFA0]'} focus:outline-none" %>

          <%= render "shared/field_errors", form: f, attribute: :password %>

          <% if @minimum_password_length %>
            <p class="mt-1 text-xs text-[#4F5A4C]/70">
              <%= t("devise.registrations.minimum_password_length", count: @minimum_password_length) %>
            </p>
          <% end %>
        </div>

        <%# パスワード確認 %>
        <div>
          <%= f.label :password_confirmation, t(".new_password_confirmation"),
                      class: "mb-1 block text-sm font-semibold text-[#4F5A4C]" %>

          <%= f.password_field :password_confirmation,
                              autocomplete: "new-password",
                              "aria-invalid": invalids[:password_confirmation],
                              "aria-describedby": (f.field_id(:password_confirmation, :errors) if invalids[:password_confirmation]),
                              class: "input input-bordered w-full bg-[#F6F5EE] text-[#4F5A4C] #{invalids[:password_confirmation] ? 'border-red-500' : 'border-[#A8BFA0]'} focus:outline-none" %>

          <%= render "shared/field_errors", form: f, attribute: :password_confirmation %>
        </div>

        <%# 現在のパスワード %>
        <div>
          <%= f.label :current_password, t(".current_password"),
                      class: "mb-1 block text-sm font-semibold text-[#4F5A4C]" %>

          <%= f.password_field :current_password,
                              autocomplete: "current-password",
                              "aria-invalid": invalids[:current_password],
                              "aria-describedby": (f.field_id(:current_password, :errors) if invalids[:current_password]),
                              class: "input input-bordered w-full bg-[#F6F5EE] text-[#4F5A4C] #{invalids[:current_password] ? 'border-red-500' : 'border-[#A8BFA0]'} focus:outline-none" %>

          <%= render "shared/field_errors", form: f, attribute: :current_password %>
        </div>

        <%# 更新ボタン %>
        <div class="flex justify-center pt-2">
          <%= f.submit class: "btn border-none bg-[#A8BFA0] text-[#4F5A4C] hover:bg-[#E3C88F]" %>
        </div>
      <% end %>

      <div class="divider my-6"></div>

      <div class="text-center">
        <h3 class="mb-2 font-semibold text-[#4F5A4C]">
          <%= t(".delete_title") %>
        </h3>
        <p class="mb-3 text-xs text-[#4F5A4C]/70">
          <%= t(".delete_alert") %>
        </p>
        <%= button_to t(".delete_btn"),
                      registration_path(resource_name),
                      data: {
                        turbo_confirm: t("devise.registrations.edit.delete_confirm")
                      },
                      method: :delete,
                      class: "btn btn-outline btn-sm text-[#4F5A4C]" %>
      </div>

      <div class="mt-4 text-center">
        <%= link_to t("back"),
                    :back,
                    class: "link text-sm text-[#4F5A4C] hover:text-[#A8BFA0]" %>
      </div>
    </div>
  </div>
</div>
