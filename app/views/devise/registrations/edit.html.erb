<% page_title = t(".title") %>

<%= render layout: "shared/layouts/centered_card",
           locals: {
             back_path: status_path,
             back_label: "前ページに戻る",
             max_width: "max-w-md"
           } do %>

  <div class="card-body">
    <h2 class="page-title">
      <%= page_title %>
    </h2>
    <%= render "shared/flash", flash: flash %>

    <%= form_for(
          resource,
          as: resource_name,
          url: registration_path(resource_name),
          html: { method: :put, class: "space-y-4", novalidate: true }
        ) do |f| %>

      <% invalids = %i[name email password password_confirmation current_password].index_with do |attribute|
          f.object.errors[attribute].any?
        end %>

      <%# ユーザー名 %>
      <div>
        <%= f.label :name, class: "form-label" %>
        <%= f.text_field :name,
                        autofocus: true,
                        autocomplete: "nickname",
                        "aria-invalid": invalids[:name],
                        "aria-describedby": (f.field_id(:name, :errors) if invalids[:name]),
                        class: "input form-field" %>

        <%= render "shared/field_errors", form: f, attribute: :name %>
      </div>

      <%# メールアドレス %>
      <div>
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email,
                          autocomplete: "email",
                          "aria-invalid": invalids[:email],
                          "aria-describedby": (f.field_id(:email, :errors) if invalids[:email]),
                          class: "input form-field" %>

        <%= render "shared/field_errors", form: f, attribute: :email %>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="mt-1 text-sm text-color/70">
            現在、<%= resource.unconfirmed_email %> の確認待ちです。
          </p>
        <% end %>
      </div>

      <%# 新しいパスワード %>
      <div>
        <div class="mb-1 flex items-center gap-2">
          <%= f.label :password, t(".new_password"), class: "form-label" %>
          <span class="text-xs text-color/70">
            <%= t(".blank_if_unchanged") %>
          </span>
        </div>

        <%= f.password_field :password,
                            autocomplete: "new-password",
                            "aria-invalid": invalids[:password],
                            "aria-describedby": (f.field_id(:password, :errors) if invalids[:password]),
                            class: "input form-field" %>

        <%= render "shared/field_errors", form: f, attribute: :password %>

        <% if @minimum_password_length %>
          <p class="mt-1 text-xs text-color/70">
            <%= t("devise.registrations.minimum_password_length", count: @minimum_password_length) %>
          </p>
        <% end %>
      </div>

      <%# パスワード確認 %>
      <div>
        <%= f.label :password_confirmation, t(".new_password_confirmation"), class: "form-label" %>
        <%= f.password_field :password_confirmation,
                            autocomplete: "new-password",
                            "aria-invalid": invalids[:password_confirmation],
                            "aria-describedby": (f.field_id(:password_confirmation, :errors) if invalids[:password_confirmation]),
                            class: "input form-field" %>

        <%= render "shared/field_errors", form: f, attribute: :password_confirmation %>
      </div>

      <%# 現在のパスワード %>
      <div>
        <%= f.label :current_password, t(".current_password"), class: "form-label" %>
        <%= f.password_field :current_password,
                            autocomplete: "current-password",
                            "aria-invalid": invalids[:current_password],
                            "aria-describedby": (f.field_id(:current_password, :errors) if invalids[:current_password]),
                            class: "input form-field" %>

        <%= render "shared/field_errors", form: f, attribute: :current_password %>
      </div>

      <%= f.submit class: "form-btn" %>

    <% end %>

    <div class="divider my-6"></div>

    <div class="text-center">
      <h3 class="mb-2 font-semibold">
        <%= t(".delete_title") %>
      </h3>
      <p class="mb-3 text-xs text-color/70">
        <%= t(".delete_alert") %>
      </p>
      <%= button_to t(".delete_btn"),
                    registration_path(resource_name),
                    data: {
                      turbo_confirm: t("devise.registrations.edit.delete_confirm")
                    },
                    method: :delete,
                    class: "simple-btn simple-btn-danger" %>
    </div>
  </div>

<% end %>
