<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center bg-[#F6F5EE] px-4">
  <div class="card w-full max-w-md bg-white shadow-xl">
    <div class="card-body">
      <h2 class="card-title justify-center text-2xl font-bold text-[#4F5A4C]">
        <%= t(".title") %>
      </h2>
      <%= render "shared/flash", flash: flash %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>

        <%= f.label :email, class: "mb-1 block text-sm font-semibold text-[#4F5A4C]" %>
        <%= f.email_field :email,
                          autofocus: true,
                          autocomplete: "email",
                          class: "input input-bordered w-full border-[#A8BFA0] bg-[#F6F5EE] text-[#4F5A4C] focus:border-[#4F5A4C] focus:outline-none" %>

        <%= f.label :password, class: "mb-1 block text-sm font-semibold text-[#4F5A4C]" %>
        <%= f.password_field :password,
                              autocomplete: "current-password",
                              class: "input input-bordered w-full border-[#A8BFA0] bg-[#F6F5EE] text-[#4F5A4C] focus:border-[#4F5A4C] focus:outline-none" %>

        <div class="pt-2">
          <%= f.submit t(".login"),
                       class: "btn w-full border-none bg-[#A8BFA0] text-[#4F5A4C] hover:bg-[#E3C88F]" %>
        </div>
      <% end %>
      <p class="text-xs text-[#4F5A4C]/70">
        <%= link_to t('.to_register_page'), new_user_registration_path %>
      </p>
    </div>
  </div>
</div>
