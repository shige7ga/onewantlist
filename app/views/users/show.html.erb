<div class="min-h-screen bg-[#F6F5EE] p-6">
  <div class="w-full max-w-md">
    <h1 class="mb-4 text-2xl font-bold text-[#4F5A4C]">
      <%= t(".title") %>
    </h1>

    <div class="card border border-[#A8BFA0] bg-white shadow-md">
      <div class="card-body">
        <div>
          <p class="text-sm font-semibold text-[#4F5A4C]/70">
            <%= User.human_attribute_name(:name) %>
          </p>
          <p class="text-lg font-semibold text-[#4F5A4C]">
            <%= @user.name %>
          </p>
        </div>

        <div>
          <p class="text-sm font-semibold text-[#4F5A4C]/70">
            <%= User.human_attribute_name(:email) %>
          </p>
          <p class="text-lg text-[#4F5A4C]">
            <%= @user.email %>
          </p>
        </div>

        <div class="card-actions mt-4">
          <%= link_to t(".edit_btn"),
                      edit_user_registration_path,
                      class: "btn border-none bg-[#A8BFA0] text-[#4F5A4C] hover:bg-[#E3C88F]" %>
        </div>
      </div>
    </div>

    <%# やりたいこと一覧 %>
    <%= render "wants/index", wants: @wants %>
  </div>
</div>
