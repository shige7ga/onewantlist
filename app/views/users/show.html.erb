<div class="min-h-screen bg-[#F6F5EE] p-6">
  <div class="w-full max-w-md">
    <%= render "shared/flash", flash: flash %>

    <%# 経験値付与・レベルアップのメッセージ（仮） %>
    <% @events.each do |event| %>
      <%= render "shared/event_message", event: event  %>
    <% end %>

    <%= render "user_card", user: @user, user_status: @user_status %>

    <%# やりたいこと一覧 %>
    <%= render "wants/index", wants: @wants %>
  </div>
</div>
